{
  "name": "peppol-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:regression": "vite build --ssr scripts/regression.ts --outDir .regression-dist && node .regression-dist/regression.js",
    "test:oauth-security": "vite build --ssr scripts/oauth-security-regression.ts --outDir .oauth-regression-dist && node .oauth-regression-dist/oauth-security-regression.js",
    "test:vercel-api-esm": "vite build --ssr scripts/vercel-api-esm-regression.ts --outDir .vercel-api-esm-dist && node .vercel-api-esm-dist/vercel-api-esm-regression.js",
    "test:vercel-usage-adapter": "vite build --ssr scripts/vercel-usage-request-regression.ts --outDir .vercel-usage-adapter-dist && node .vercel-usage-adapter-dist/vercel-usage-request-regression.js",
    "test:vercel-conversions-adapter": "vite build --ssr scripts/vercel-conversions-request-regression.ts --outDir .vercel-conversions-adapter-dist && node .vercel-conversions-adapter-dist/vercel-conversions-request-regression.js",
    "test:vercel-api-auth-adapters": "vite build --ssr scripts/vercel-api-auth-adapter-regression.ts --outDir .vercel-api-auth-adapter-dist && node .vercel-api-auth-adapter-dist/vercel-api-auth-adapter-regression.js",
    "test:bulk-history": "vite build --ssr scripts/bulk-history-regression.ts --outDir .bulk-history-dist && node .bulk-history-dist/bulk-history-regression.js",
    "test:auth-regression": "vite build --ssr scripts/auth-regression.ts --outDir .auth-regression-dist && node .auth-regression-dist/auth-regression.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-table": "^8.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.510.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.44.0",
    "@types/node": "^22.15.0"
  }
}
